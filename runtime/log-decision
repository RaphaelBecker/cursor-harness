#!/usr/bin/env python3
"""Append one decision row to .cursor/night-shift/decisions.tsv (cwd = worktree)."""
from __future__ import annotations

import sys
from datetime import datetime, timezone
from pathlib import Path

HEADER = "ts\tphase\tdecision\twhy\tevidence\tresult\n"


def cell(value: str) -> str:
    text = " ".join(value.split()).replace("\t", " ")
    if text[:1] in {"=", "+", "-", "@"}:
        text = "'" + text
    return text


def main(argv: list[str]) -> int:
    if len(argv) != 5:
        print(
            "usage: log-decision <phase> <decision> <why> <evidence> <result>",
            file=sys.stderr,
        )
        return 2
    path = Path(".cursor") / "night-shift" / "decisions.tsv"
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.is_file():
        path.write_text(HEADER, encoding="utf-8")
    row = "\t".join(
        [datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), *map(cell, argv)]
    )
    with path.open("a", encoding="utf-8") as handle:
        handle.write(row + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
