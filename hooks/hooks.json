{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-bootstrap.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/protect-secrets-prompt.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-destructive-shell.sh",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/context-governor.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/context-governor.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/context-governor.sh",
        "failClosed": false,
        "timeout": 10,
        "loop_limit": 5
      }
    ]
  }
}
